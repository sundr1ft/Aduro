{
  "name": "@sundr1ft/aduro",
  "version": "0.1.0",
  "description": "Minimal personal static site generator",
  "license": "MIT",
  "keywords": [
    "static-site-generator",
    "ssg",
    "blog",
    "markdown",
    "handlebars",
    "cli"
  ],
  "author": "sundr1ft",
  "repository": {
    "type": "git",
    "url": "https://github.com/sundr1ft/Aduro.git"
  },
  "homepage": "https://github.com/sundr1ft/Aduro#readme",
  "bugs": {
    "url": "https://github.com/sundr1ft/Aduro/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    }
  },
  "bin": {
    "aduro": "./dist/index.js"
  },
  "scripts": {
    "compile": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json && husky",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test",
    "secretlint": "secretlint \"**/*\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:build": "tsx src/index.ts build site",
    "dev:serve": "tsx src/index.ts serve site",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:md": "markdownlint-cli2 \"site/content/**/*.md\"",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "marked": "^12.0.0",
    "ws": "^8.17.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint",
      "prettier --check"
    ],
    "*.{js,mjs,json,yaml,yml,md,css,html}": "prettier --check",
    "**/*": "secretlint"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "markdownlint-cli2": "^0.22.1",
    "prettier": "^3.8.3",
    "secretlint": "^13.0.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.6"
  }
}
